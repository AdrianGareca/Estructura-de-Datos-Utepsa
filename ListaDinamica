ListaEnlazada.cpp
#include "ListaEnlazada.h"

ListaEnlazada::ListaEnlazada()
{
    primero=NULL; //No existen elementos en Lista
    dim=0;
}

ListaEnlazada::~ListaEnlazada()
{
    nodo *p=primero;
    while(p!=NULL){
        nodo *aux=p;
        p=p->siguiente;
        delete aux;
    }
}
void ListaEnlazada::adicionar(int x){
    nodo *nuevito=new nodo();
    nuevito->dato=x;
    if(primero==NULL){
        primero=nuevito;
    }
    else{
        nodo *p=primero;
        while(p->siguiente!=NULL){
            p=p->siguiente;
        }
        p->siguiente=nuevito;
    }
    dim ++;
}
void ListaEnlazada::mostrar(){
    nodo *p=primero;
    while(p!=NULL){
        cout<<p->dato<<", ";
        p=p->siguiente;
    }
}
int ListaEnlazada::dimension(){
    return dim;
}
void  ListaEnlazada::insertarPrimero(int x){
    nodo *nuevito=new nodo();
    nuevito->dato=x;
    nuevito->siguiente=primero;
    primero=nuevito;
    dim++;
}
